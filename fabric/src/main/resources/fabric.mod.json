{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_authors}"],
    "contact": {},
    "license": "${mod_license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["net.zeronexus.quickstackcraft.fabric.QuickStackCraftFabric"],
        "client": ["net.zeronexus.quickstackcraft.fabric.QuickStackCraftFabricClient"]
    },
    "mixins": [
        "quickstackcraft-common.mixins.json",
        "quickstackcraft.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "architectury": ">=${architectury_api_version}",
        "java": ">=${java_version}"
    }
}
